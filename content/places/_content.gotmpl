{{/* Generate one page per place that has photos (auto-syncs with
     data/places.json + the index). Slug = urlized city. */}}
{{ $palette := site.Params.palette }}
{{/* A place gets a page when it has PUBLISHED photos — data/index.json
     "places" (build_index.py) already applies the withheld gate, so no
     manifest scan is needed here. */}}
{{ $published := index hugo.Data.index "places" | default dict }}
{{ range $i, $pl := (index hugo.Data.places "places") }}
  {{ $has := isset $published $pl.city }}
  {{ if $has }}
    {{ $.AddPage (dict
        "kind" "page"
        "path" ($pl.city | urlize)
        "title" $pl.name
        "params" (dict "place" $pl.city "name" $pl.name "state" $pl.state "color" (index $palette (mod $i 5)))) }}
  {{ end }}
{{ end }}
